{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(dir)",
      "Bash(Get-ChildItem:*)"
    ],
    "deny": [
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(id_rsa)",
      "Edit(id_ed25519)",
      "Edit(secrets.*)",
      "Edit(credentials.*)",
      "Edit(*.pem)",
      "Edit(*.key)",
      "Edit(.ssh/**)",
      "Edit(.aws/credentials)",
      "Edit(.git/config)",
      "Edit(.npmrc)",
      "Edit(.pypirc)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(id_rsa)",
      "Write(secrets.*)",
      "Write(credentials.*)",
      "Write(*.pem)",
      "Write(*.key)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(rm -rf:*)",
      "Bash(Remove-Item -Recurse -Force:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(npm publish:*)",
      "Bash(pip install:*)",
      "Bash(npm install -g:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%USERPROFILE%\\.claude\\hooks\\guard-secrets.ps1\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%USERPROFILE%\\.claude\\hooks\\notify.ps1\""
          }
        ]
      }
    ]
  }
}
